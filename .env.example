# Anthropic API key for LLM-assisted music curation.
#
# Used by:
#   - scripts/curate.ts  (build-time enrichment of lib/seeds.json)
#   - app/api/curate/route.ts  (runtime fallback when seeded artists don't resolve)
#
# Get a key from https://console.anthropic.com/settings/keys
# Set a monthly spending limit at https://console.anthropic.com/settings/limits
# (Recommended: $5 — this app's estimated cost is well under $1 total.)
#
# Copy this file to `.env.local` (NOT `.env`) — `.env.local` is automatically
# git-ignored by Next.js so the key never goes into version control.
ANTHROPIC_API_KEY=
